{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qteam.local/schemas/review-result.schema.json",
  "type": "object",
  "required": ["axis", "verdict", "trajectory_verdict", "calibration_results", "findings", "resolved_ids", "invalid_ids", "upheld_ids", "invalid_evidence"],
  "properties": {
    "axis": {"enum": ["spec", "standards", "risk"]},
    "verdict": {"enum": ["pass", "needs-fix"]},
    "trajectory_verdict": {"enum": ["pass", "needs-fix"]},
    "calibration_results": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {"enum": ["pass", "needs-fix"]}
    },
    "findings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "severity": {"enum": ["P0", "P1", "P2", "P3"]},
          "title": {"type": "string", "minLength": 1},
          "review_evidence": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1},
          "fix_direction": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "file": {"type": ["string", "null"]},
          "line": {"type": ["integer", "null"], "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "resolved_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]*$"}},
    "invalid_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]*$"}},
    "upheld_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]*$"}},
    "invalid_evidence": {
      "type": "object",
      "propertyNames": {"pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]*$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "pass"}}},
      "then": {"properties": {"trajectory_verdict": {"const": "pass"}, "findings": {"maxItems": 0}, "upheld_ids": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"verdict": {"const": "needs-fix"}}},
      "then": {
        "anyOf": [
          {"properties": {"findings": {"minItems": 1}}},
          {"properties": {"upheld_ids": {"minItems": 1}}}
        ],
        "properties": {
          "findings": {
            "items": {"required": ["id", "severity", "title", "review_evidence", "impact", "fix_direction", "owner"]}
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
