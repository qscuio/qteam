{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qteam.local/schemas/artifact-lint.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "status", "sources", "errors", "warnings"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"enum": ["spec", "tickets"]},
    "status": {"enum": ["pass", "pass-with-warnings", "fail"]},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "sha256"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "errors": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
    "warnings": {"type": "array", "items": {"$ref": "#/$defs/issue"}}
  },
  "additionalProperties": false,
  "$defs": {
    "issue": {
      "type": "object",
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z]+[0-9]{3}$"},
        "severity": {"enum": ["error", "warning"]},
        "message": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  }
}
