{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qteam.local/schemas/tdd-cycle.schema.json",
  "type": "object",
  "required": ["seam_id", "behavior", "test_files", "command", "red_pattern", "red_commit", "red_exit_code", "red_log", "green_commit", "green_exit_code", "green_log", "verified_at"],
  "properties": {
    "seam_id": {"type": "string", "minLength": 1},
    "behavior": {"type": "string", "minLength": 1},
    "test_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "command": {"type": "string", "minLength": 1},
    "stream_schema_version": {"const": 1},
    "red_pattern": {"type": "string", "minLength": 1},
    "red_commit": {"type": "string", "minLength": 40},
    "red_exit_code": {"type": "integer", "not": {"const": 0}},
    "red_log": {"type": "string", "minLength": 1},
    "red_log_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "red_stderr_log": {"type": "string", "minLength": 1},
    "red_stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "green_commit": {"type": "string", "minLength": 40},
    "green_exit_code": {"const": 0},
    "green_log": {"type": "string", "minLength": 1},
    "green_log_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "green_stderr_log": {"type": "string", "minLength": 1},
    "green_stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verified_at": {"type": "string", "minLength": 1}
  },
  "allOf": [{
    "if": {"required": ["stream_schema_version"]},
    "then": {"required": ["red_stderr_log", "red_log_sha256", "red_stderr_sha256", "green_log_sha256", "green_stderr_log", "green_stderr_sha256"]}
  }],
  "additionalProperties": false
}
