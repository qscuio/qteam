{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qteam.local/schemas/spec-drift.schema.json",
  "type": "object",
  "required": ["schema_version", "run_id", "head_sha", "sources", "summary", "changes", "decisions", "no_drift_evidence", "approval_required", "apply_status", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"$ref": "#/$defs/id"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "summary": {"type": "string", "minLength": 1},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "layer", "original", "actual", "reason", "proposal", "decision_id", "status"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "layer": {"enum": ["requirements", "design", "tasks"]},
          "original": {"type": "string", "minLength": 1},
          "actual": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "proposal": {"type": "string", "minLength": 1},
          "decision_id": {"$ref": "#/$defs/id"},
          "status": {"const": "pending"}
        },
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "change_sha256", "binding_sha256"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "change_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "no_drift_evidence": {"type": ["string", "null"]},
    "approval_required": {"type": "boolean"},
    "apply_status": {"const": "proposal-only"},
    "created_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]*$"}
  }
}
