{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qteam.local/schemas/trajectory.schema.json",
  "type": "object",
  "required": ["schema_version", "subject_type", "subject_id", "execution", "runner", "trace_sha256", "counts", "anomalies", "disposition", "generated_at"],
  "properties": {
    "schema_version": {"const": 1},
    "subject_type": {"enum": ["worker", "review"]},
    "subject_id": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "execution": {
      "type": "object",
      "required": ["tier", "model", "thinking", "provider", "family"],
      "properties": {
        "tier": {"enum": ["economy", "standard", "deep"]},
        "model": {"type": "string", "minLength": 1},
        "thinking": {"enum": ["low", "medium", "high", "xhigh"]},
        "provider": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "runner": {"type": "object", "required": ["name", "version"], "properties": {"name": {"const": "codex-cli"}, "version": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "trace_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "counts": {
      "type": "object",
      "required": ["events", "tool_calls", "command_calls", "failed_calls", "empty_result_calls", "duplicate_calls", "input_tokens", "cached_input_tokens", "output_tokens", "reasoning_output_tokens"],
      "properties": {
        "events": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "command_calls": {"type": "integer", "minimum": 0},
        "failed_calls": {"type": "integer", "minimum": 0},
        "empty_result_calls": {"type": "integer", "minimum": 0},
        "duplicate_calls": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "reasoning_output_tokens": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "anomalies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "count"],
        "properties": {
          "code": {"enum": ["TRACE_DUPLICATE_CALL", "TRACE_EMPTY_RESULT", "TRACE_FAILED_CALL"]},
          "count": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "disposition": {"enum": ["pass", "escalate", "quarantine"]},
    "generated_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
