{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qteam.local/schemas/queue-item.schema.json",
  "type": "object",
  "required": ["schema_version", "id", "kind", "targets", "priority", "status", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "kind": {"enum": ["task", "quality", "review", "fix", "research"]},
    "targets": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]*$"}},
    "priority": {"type": "integer", "minimum": 0, "maximum": 9},
    "status": {"enum": ["pending", "claimed", "completed", "failed"]},
    "created_at": {"type": "string", "minLength": 1},
    "claimed_by": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "claimed_at": {"type": "string", "minLength": 1},
    "completed_at": {"type": "string", "minLength": 1},
    "evidence": {"type": "string", "minLength": 1, "maxLength": 4096}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "pending"}}},
      "then": {"not": {"anyOf": [
        {"required": ["claimed_by"]}, {"required": ["claimed_at"]},
        {"required": ["completed_at"]}, {"required": ["evidence"]}
      ]}}
    },
    {
      "if": {"properties": {"status": {"const": "claimed"}}},
      "then": {
        "required": ["claimed_by", "claimed_at"],
        "not": {"anyOf": [
          {"required": ["completed_at"]}, {"required": ["evidence"]}
        ]}
      }
    },
    {
      "if": {"properties": {"status": {"enum": ["completed", "failed"]}}},
      "then": {"required": ["claimed_by", "claimed_at", "completed_at", "evidence"]}
    }
  ],
  "additionalProperties": false
}
