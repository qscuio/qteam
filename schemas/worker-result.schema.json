{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qteam.local/schemas/worker-result.schema.json",
  "type": "object",
  "required": ["schema_version", "task", "exit_code", "started_at", "finished_at", "stdout", "stderr"],
  "properties": {
    "schema_version": {"const": 1},
    "task": {"type": "string"},
    "exit_code": {"type": "integer"},
    "error": {"type": ["string", "null"]},
    "started_at": {"type": "string"},
    "finished_at": {"type": "string"},
    "stdout": {"type": "string"},
    "stderr": {"type": "string"}
  },
  "additionalProperties": true
}
